# ==========================================
# Terraform
# ==========================================

# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files
*.tfplan
*.plan

# Crash logs
crash.log
crash.*.log
*.log

# Terraform lock info
.terraform.tfstate.lock.info

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files (often contain secrets)
*.tfvars
*.tfvars.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# ==========================================
# Environment & Secrets
# ==========================================

.env
.env.*
.env.local

# Certificates & Private Keys
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# Local credential files
aws-credentials.json

# IAM policy files generated/downloaded locally
iam_policy.json
missing-alb-policy.json
fix-listener-policy.json

# ==========================================
# Editor Files
# ==========================================

.vscode/
.idea/

# ==========================================
# OS Files
# ==========================================

.DS_Store
Thumbs.db
Desktop.ini
*~

# ==========================================
# Python (if helper scripts are added)
# ==========================================

__pycache__/
*.pyc